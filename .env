# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── AI Providers ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ── OpenRouter (يدعم نماذج مجانية كثيرة) ─────────────────────
# احصل على مفتاحك من: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key
# النموذج الافتراضي (غيّره من الإعدادات):
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# الـ provider الافتراضي: gemini | openai | anthropic | openrouter
DEFAULT_AI_PROVIDER=gemini

# ── App Security ──────────────────────────────────────────────
APP_PASSWORD=POILKJ09
JWT_SECRET=change_this_to_random_64_chars_string

# ── Render ────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=https://yoursite.infinityfreeapp.com

# ── Cache ─────────────────────────────────────────────────────
CACHE_TTL_MINUTES=60
